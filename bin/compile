#!/usr/bin/env bash

function indent() {
	c='s/^/       /'
	case $(uname) in
		Darwin) sed -l "$c";;
		*)      sed -u "$c";;
	esac
}

ENV_DIR=${3:-}
ssh_key="$( cat ${ENV_DIR}/SSH_KEY )"
ssh_hosts="${SSH_HOSTS:-"git@github.com"}"

#
# !! WARNING !!
#
# OpenSSH doesn't use $HOME.
#
# Consequently, we have to:
# - use a variable ($real_home) to point to the **real** home directory
#   when in build phase (which is different than the one pointed by $HOME).
# - use another one ($ssh_home) to point to the home directory
#   when in run phase. In this case, we **must** use $HOME:
#     During build, $HOME points to something like `/build/<build_id>` ;
#     During run, $HOME points to `/app`.
#     We have to copy the files to (build-)$HOME so they end up in (run-)$HOME.
#     Using $HOME makes this transparent.
# - copy the generated files in $real_home to $ssh_home at the end
#   of the process.
#

if [ -n "${ssh_key}" ]; then
	echo "-----> Running SSH private key setup"

	# Path to the **real** SSH home directory when in BUILD phase:
	# (not the one pointed by $HOME!)
	real_home="$( getent passwd "$( whoami )" | cut -d ':' -f6 )/.ssh"

	# Path to the SSH home directory when in RUN phase:
	ssh_home="${HOME}/.ssh"

	mkdir --parents "${real_home}" "${ssh_home}"
	
	id_file="${real_home}/id_rsa"

	# Create the SSH private key:
	echo "${ssh_key}" | base64 --decode > "${id_file}"

	chmod 700 "${real_home}" "${ssh_home}"
	chmod 400 "${id_file}"

	if [ -n "${BUILDPACK_DEBUG}" ]; then
		echo "Successfully imported SSH key to ${id_file}" | indent
	fi

	# Populate the known_hosts file:
	IFS=',' read -ra HOST <<< "${ssh_hosts}"
	for i in "${HOST[@]}"; do
		ssh -oStrictHostKeyChecking=no -T "${i}" -i "${id_file}" 2>&1 | indent
	done

	# Now that everything is setup in real_home,
	# copy the files to ssh_home so they are also available at RUN time:
	cp --archive "${real_home}/." "${ssh_home}/"

	if [ -n "${BUILDPACK_DEBUG}" ]; then
		echo "Successfully copied SSH files to ${ssh_home}" | indent
	fi

else
	echo "-----> No SSH private key"
fi

# Keep SSH_KEY's existing behavior; additional keys are optional and repo-scoped.
buildpack_dir="$(cd "$(dirname "$0")/.." && pwd)"
real_ssh_home="$(getent passwd "$(whoami)" | cut -d ':' -f6)/.ssh"
bash "$buildpack_dir/bin/additional-keys" "$ENV_DIR" "$real_ssh_home" "$buildpack_dir/export"
